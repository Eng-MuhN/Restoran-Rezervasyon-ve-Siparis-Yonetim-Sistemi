@{
    ViewBag.Title = "Ana Sayfa";
}

<section id="about" class="row align-items-center py-5">
    <div class="col-md-5">
        <p class="about-words">Taze.<br />Lezzetli.<br />Samimi.</p>
    </div>
    <div class="col-md-7">
        <h2>Anadolu'nun lezzetleri sofranızda</h2>
        <p class="text-muted">
            Geleneksel tarifleri en taze malzemelerle hazırlıyoruz.
            İster masanızı ayırtın, ister online sipariş verin.
        </p>
    </div>
</section>

<section id="specialties" class="py-5">
    <h2 class="text-center">Özel Lezzetlerimiz</h2>
    <p class="text-center text-muted mb-4">Şefimizin en sevilen tabakları</p>

    <div class="row">
        <div class="col-12 col-sm-6 col-lg-4 mb-4">
            <div class="card">
                <img src="~/images/adana_kebab.jpeg" class="card-img-top" alt="Adana Kebap" />
                <div class="card-body">
                    <h5 class="card-title">Adana Kebap</h5>
                    <p class="card-text text-muted">Közlenmiş biber ve domates ile</p>
                    <p class="fw-bold">350 ₺</p>
                    <a href="#" class="btn btn-danger">Sepete Ekle</a>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-lg-4 mb-4">
            <div class="card">
                <img src="~/images/mercimek_corbasi.jpeg" class="card-img-top" alt="Mercimek Çorbası" />
                <div class="card-body">
                    <h5 class="card-title">Mercimek Çorbası</h5>
                    <p class="card-text text-muted">Günlük taze, limon ile servis</p>
                    <p class="fw-bold">120 ₺</p>
                    <a href="#" class="btn btn-danger">Sepete Ekle</a>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-lg-4 mb-4">
            <div class="card">
                <img src="~/images/kunefe.jpeg" class="card-img-top" alt="Künefe" />
                <div class="card-body">
                    <h5 class="card-title">Künefe</h5>
                    <p class="card-text text-muted">Antep fıstıklı, sıcak servis</p>
                    <p class="fw-bold">180 ₺</p>
                    <a href="#" class="btn btn-danger">Sepete Ekle</a>
                </div>
            </div>
        </div>
    </div>
</section>



