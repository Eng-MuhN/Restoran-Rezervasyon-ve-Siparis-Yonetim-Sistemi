        new { Category = "Başlangıç & Salata", Name = "Çoban Salata", Description = "Domates, salatalık ve yeşilliklerle.", Price = "120 TL", Image = "coban-salata.svg", Label = "Salata" },
        new { Category = "Başlangıç & Salata", Name = "Mevsim Salata", Description = "Mevsim yeşillikleriyle taze salata.", Price = "120 TL", Image = "mevsim-salata.svg", Label = "Salata" },

        new { Category = "Tatlılar", Name = "Sütlaç", Description = "Fırınlanmış, hafif sütlü tatlı.", Price = "130 TL", Image = "sutlac.svg", Label = "Tatlı" },
        new { Category = "Tatlılar", Name = "Künefe", Description = "Sıcak servis edilen peynirli kadayıf.", Price = "220 TL", Image = "kunefe.svg", Label = "Sıcak tatlı" },
        new { Category = "Tatlılar", Name = "Katmer", Description = "İncecik hamur, Antep fıstığı ve kaymak.", Price = "230 TL", Image = "katmer.svg", Label = "Tatlı" },

        new { Category = "İçecekler", Name = "Ayran", Description = "Kebapların yanına serin bir eşlikçi.", Price = "65 TL", Image = "ayran.svg", Label = "Soğuk içecek" },
        new { Category = "İçecekler", Name = "Şalgam", Description = "Acılı veya acısız tercih edilebilir.", Price = "65 TL", Image = "salgam.svg", Label = "Soğuk içecek" },
        new { Category = "İçecekler", Name = "Kutu İçecek", Description = "Soğuk kutu içecek çeşitleri.", Price = "70 TL", Image = "kutu-icecek.svg", Label = "Soğuk içecek" },
        new { Category = "İçecekler", Name = "Soda", Description = "Serinletici sade soda.", Price = "40 TL", Image = "soda.svg", Label = "Soğuk içecek" },
        new { Category = "İçecekler", Name = "Su", Description = "Soğuk su.", Price = "20 TL", Image = "su.svg", Label = "Soğuk içecek" }
    };
}


<main class="necip-menu-page">
    <section class="menu-hero">
        <div class="container menu-hero-inner">
            <div class="menu-hero-copy">
                <p class="menu-eyebrow">USTADAN SOFRANIZA</p>
                <h1>Menümüz</h1>
                <p class="menu-hero-subtitle">Köz ateşinde hazırlanan lezzetleri keşfet.</p>
                <div class="menu-hero-rule"></div>
                <span>Kebap <i>•</i> Dürüm <i>•</i> Pide</span>
            </div>
            <div class="menu-hero-stamp" aria-hidden="true">
                <span>KEBAPÇI</span>
                <strong>NECİP</strong>
                <small>USTA İŞİ LEZZET</small>
            </div>
        </div>
    </section>

    <section class="container menu-content">
        <div class="menu-panel">
            <div class="menu-heading-row">
                <div>
                    <p class="menu-eyebrow menu-eyebrow-light">NECİP USTA'NIN MUTFAĞINDAN</p>
                    <h2>Özenle hazırlananlar</h2>
                </div>
                <p class="menu-heading-note">Canın ne çektiyse, sofranda yeri var.</p>
            </div>

            <nav class="menu-categories" aria-label="Menü kategorileri">
                @for (var i = 0; i < categories.Length; i++)
                {
                    <a class="menu-pill @(i == 0 ? "active" : "")" href="#@categories[i].Id">@categories[i].Name</a>
                }
            </nav>

            @foreach (var category in categories)
            {
                <section class="menu-section" id="@category.Id">
                    <div class="menu-section-heading">
                        <h3>@category.Name</h3>
                        <span></span>
                    </div>
                    <div class="row">
                        @foreach (var item in menuItems)
                        {
                            if (item.Category == category.Name)
                            {
                                <div class="col-sm-6 col-lg-4 menu-col">
                                    <article class="menu-card">
                                        <div class="menu-card-photo">
                                            <img src="@Url.Content("~/images/menu-gorseller/" + item.Image)" alt="@item.Name" loading="lazy" />
                                            <span class="menu-card-label">@item.Label</span>
                                        </div>
                                        <div class="menu-card-body">
                                            <h4>@item.Name</h4>
                                            <p>@item.Description</p>
                                            <div class="menu-card-bottom">
                                                <strong>@item.Price</strong>
                                                <span class="menu-card-plus" aria-hidden="true">+</span>
                                            </div>
                                        </div>
                                    </article>
                                </div>
                            }
                        }
                    </div>
                </section>
            }

            <aside class="menu-callout">
                <div class="menu-callout-mark" aria-hidden="true">N</div>
                <div>
                    <h3>Sofranda yerimiz hazır.</h3>
                    <p>Sevdiklerinle paylaşacağın lezzetler Kebabçı Necip'te.</p>
                </div>
                <a href="@Url.Action("Index", "Home")" class="menu-callout-link">Ana sayfaya dön <span aria-hidden="true">→</span></a>
            </aside>
        </div>
    </section>
</main>



