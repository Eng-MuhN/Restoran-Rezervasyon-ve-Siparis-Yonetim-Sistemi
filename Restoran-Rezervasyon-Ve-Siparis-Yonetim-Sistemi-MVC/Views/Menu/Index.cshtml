        new { Category = "Pide & Lahmacun", Name = "Kuşbaşılı Pide", Description = "Kuşbaşı etli, fırından sıcak pide.", Price = "420 TL", Image = "kusbasili-pide.svg", Label = "Taş fırından" },

        new { Category = "Başlangıç & Salata", Name = "Ezme", Description = "Acılı, taze ve sofraya yakışan bir başlangıç.", Price = "100 TL", Image = "ezme.svg", Label = "Meze" },
        new { Category = "Başlangıç & Salata", Name = "Haydari", Description = "Yoğurtlu, serinletici meze.", Price = "100 TL", Image = "haydari.svg", Label = "Meze" },
        new { Category = "Başlangıç & Salata", Name = "Közlenmiş Biber", Description = "Köz aromasıyla sofraya eşlik eder.", Price = "80 TL", Image = "kozlenmis-biber.svg", Label = "Meze" },
