        new { Name = "Dürümler", Id = "durumler" },
        new { Name = "Pide & Lahmacun", Id = "pide-lahmacun" },
        new { Name = "Başlangıç & Salata", Id = "baslangic-salata" },
        new { Name = "Tatlılar", Id = "tatlilar" },
        new { Name = "İçecekler", Id = "icecekler" }
    };

    var menuItems = new[]
    {
        new { Category = "Kebaplar", Name = "Adana Kebap", Description = "Baharatı yerinde, köz ateşinde pişer.", Price = "400 TL", Image = "adana-kebap.svg", Label = "Usta işi" },
        new { Category = "Kebaplar", Name = "Urfa Kebap", Description = "Yumuşak baharatıyla sade ve doyurucu.", Price = "400 TL", Image = "urfa-kebap.svg", Label = "Acısız" },
        new { Category = "Kebaplar", Name = "Tavuk Şiş", Description = "Köz sebzelerle servis edilir.", Price = "350 TL", Image = "tavuk-sis.svg", Label = "Izgaradan" },
        new { Category = "Kebaplar", Name = "Kuzu Şiş", Description = "Köz ateşinde pişen kuzu şiş.", Price = "600 TL", Image = "kuzu-sis.svg", Label = "Kuzu eti" },
        new { Category = "Kebaplar", Name = "Beyti", Description = "Lavaşta sarılı, yoğurt ve sos eşliğinde.", Price = "500 TL", Image = "beyti.svg", Label = "Yoğurtlu" },
        new { Category = "Kebaplar", Name = "Patlıcanlı Kebap", Description = "Baharatlı kebap, köz patlıcanla.", Price = "550 TL", Image = "patlicanli-kebap.svg", Label = "Köz patlıcan" },
        new { Category = "Kebaplar", Name = "Karışık Izgara", Description = "Izgaradan seçilmiş lezzetler bir arada.", Price = "850 TL", Image = "karisik-izgara.svg", Label = "Karışık" },

        new { Category = "Dürümler", Name = "Adana Dürüm", Description = "Lavaşta Adana kebap, taze yeşilliklerle.", Price = "350 TL", Image = "adana-durum.svg", Label = "Dürüm" },
        new { Category = "Dürümler", Name = "Urfa Dürüm", Description = "Lavaşta Urfa kebap, taze yeşilliklerle.", Price = "350 TL", Image = "urfa-durum.svg", Label = "Acısız" },
        new { Category = "Dürümler", Name = "Tavuk Dürüm", Description = "Izgara tavuk, lavaş ve taze yeşillikler.", Price = "250 TL", Image = "tavuk-durum.svg", Label = "Dürüm" },

        new { Category = "Pide & Lahmacun", Name = "Lahmacun", Description = "İnce hamur, bol yeşillikle servis edilir.", Price = "160 TL", Image = "lahmacun.svg", Label = "Taş fırından" },
        new { Category = "Pide & Lahmacun", Name = "Kaşarlı Pide", Description = "Fırından sıcak, uzayan kaşar peyniriyle.", Price = "350 TL", Image = "kasarli-pide.svg", Label = "Taş fırından" },
